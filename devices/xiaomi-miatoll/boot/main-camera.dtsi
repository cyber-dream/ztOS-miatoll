// The Redmi Note 9 Pro (joyeuse)'s main camera, the S5KGW1: its power, pins, lens and CSI
// link to CAMSS (csiphy1, 3 lanes). Not applied by build-boot.sh yet: CAMSS then waits for
// the sensor, and it gives no frames (kernel/s5kgw1/README.md). The boot tree has no labels,
// so it goes on the decompiled tree, and references are by path:
//   dtc -I dtb -O dts miatoll.dtb > t.dts; cat t.dts main-camera.dtsi | dtc -I dts -O dtb > out.dtb

/ {
	main_avdd: regulator-main-avdd-2p8 {
		compatible = "regulator-fixed";
		regulator-name = "main_avdd_2p8";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		regulator-enable-ramp-delay = <100>;
		enable-active-high;
		gpio = <&{/soc@0/spmi@c440000/pmic@4/gpio@c000} 9 0>;
		vin-supply = <&{/soc@0/rsc@18200000/regulators-1/bob}>;
	};

	main_avdd2: regulator-main-avdd2-1p8 {
		compatible = "regulator-fixed";
		regulator-name = "main_avdd2_1p8";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-enable-ramp-delay = <100>;
		enable-active-high;
		gpio = <&{/soc@0/spmi@c440000/pmic@4/gpio@c000} 12 0>;
		vin-supply = <&{/soc@0/rsc@18200000/regulators-0/ldo13}>;
	};

	/* 1.2 V on a 48 MP board, 1.05 V on a 64 MP one: one enable, the LDO fitted decides */
	main_dvdd: regulator-main-dvdd {
		compatible = "regulator-fixed";
		regulator-name = "main_dvdd";
		regulator-min-microvolt = <1050000>;
		regulator-max-microvolt = <1050000>;
		regulator-enable-ramp-delay = <100>;
		enable-active-high;
		gpio = <&{/soc@0/pinctrl@3500000} 42 0>;
	};
};

&{/soc@0/pinctrl@3500000} {
	main_cam_default: cam-main-default-state {
		rst-pins {
			pins = "gpio25";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};

		mclk1-pins {
			pins = "gpio14";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};
	};
};

&{/soc@0/cci@ac4a000/i2c-bus@0} {
	status = "okay";

	main_vcm: camera-lens@c {
		compatible = "dongwoon,dw9800";
		reg = <0x0c>;
		vin-supply = <&{/soc@0/rsc@18200000/regulators-0/ldo13}>;
		vdd-supply = <&{/regulator-wide-afvdd-2p8}>;
	};

	camera@3d {
		compatible = "samsung,s5kgw1";
		reg = <0x3d>;
		vana-supply = <&main_avdd>;
		vdig-supply = <&main_dvdd>;
		vio-supply = <&{/soc@0/rsc@18200000/regulators-0/ldo13}>;
		clocks = <&{/soc@0/clock-controller@ad00000} 63>;	/* CAM_CC_MCLK1_CLK */
		assigned-clocks = <&{/soc@0/clock-controller@ad00000} 63>;
		assigned-clock-rates = <19200000>;
		reset-gpios = <&{/soc@0/pinctrl@3500000} 25 0>;
		pinctrl-names = "default";
		pinctrl-0 = <&main_cam_default>;
		orientation = <1>;
		rotation = <270>;
		lens-focus = <&main_vcm>;

		port {
			main_cam_ep: endpoint {
				data-lanes = <1 2 3>;
				link-frequencies = /bits/ 64 <1097600000>;
				remote-endpoint = <&camss_csiphy1_ep>;
			};
		};
	};
};

&{/soc@0/camss@acb3000/ports/port@1} {
	camss_csiphy1_ep: endpoint {
		data-lanes = <0 1 2>;
		remote-endpoint = <&main_cam_ep>;
	};
};
