#!/bin/sh
# The sound card, every boot. The LPASS pin controller (627c0000.pinctrl)
# asks the ADSP's AFE for its clocks as soon as the AFE's clock device shows
# up, which can be before the ADSP's audio domain takes the vote: the vote
# times out (-110), the pin controller is left unbound, and the codecs, the
# SoundWire buses and with them the card wait for it for good. Bound again
# once the ADSP is up, it comes up at once.
PIN=627c0000.pinctrl
DRV=/sys/bus/platform/drivers/qcom-sc7280-lpass-lpi-pinctrl
card() { grep -q Xiaomimiatoll /proc/asound/cards 2>/dev/null; }

# The UCM profile's BootSequence: the speaker amplifier's digital volume and
# channel (TAS2562 "Digital Volume Control" 109, "ASI1 Sel" LeftRightDiv2).
# alsa-restore puts back the state saved at the last shutdown and runs the
# BootSequence only when there is none; a saved state with the amplifier at
# 0 (-110 dB) leaves the speaker silent for good. Run after alsa-restore,
# and after udev's own `alsactl restore` for the new card
# (90-alsa-restore.rules), which can come later than the service.
boot() {
	i=0
	while ! systemctl -q is-active alsa-restore.service && [ "$i" -lt 20 ]; do i=$((i + 1)); sleep 1; done
	udevadm settle -t 30 || true
	while pgrep -x alsactl > /dev/null && [ "$i" -lt 40 ]; do i=$((i + 1)); sleep 1; done
	alsaucm -c hw:0 set _boot "" && echo "UCM BootSequence run"
}

# the ADSP up (remoteproc "running"), within a minute
i=0
until grep -qx running /sys/class/remoteproc/*/state 2>/dev/null && [ -d /sys/bus/platform/devices/$PIN ]; do
	i=$((i + 1)); [ "$i" -ge 60 ] && { echo "no ADSP after 60 s" >&2; exit 1; }
	sleep 1
done
for try in 1 2 3 4 5; do
	# a card made on its own in the meantime: nothing to do
	for w in 1 2 3 4 5; do card && { echo "sound card up (try $try)"; boot; exit 0; }; sleep 1; done
	if [ ! -e "$DRV/$PIN" ]; then
		echo "binding $PIN again (try $try)"
		echo "$PIN" > "$DRV/bind" 2>/dev/null || true
	fi
done
card || { echo "no sound card after 5 tries" >&2; exit 1; }
boot
